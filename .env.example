APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Password hashing. 12 bcrypt rounds is the module's baseline; switch
# HASH_DRIVER to argon2id for Argon2 instead.
BCRYPT_ROUNDS=12
# HASH_DRIVER=argon2id

#--------------------------------------------------------------------------
# Authentication & User Management module
#--------------------------------------------------------------------------
# Signing key for access/refresh JWTs. Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Leave empty to fall back to APP_KEY (acceptable locally, not in production).
JWT_SECRET=
JWT_ALGO=HS256
JWT_ACCESS_TTL=900          # 15 minutes, in seconds
JWT_REFRESH_TTL=604800      # 7 days, in seconds
JWT_LEEWAY=5

# Seconds a just-rotated refresh token may still be presented, so a refresh
# whose response never reached the browser does not end the session. Only
# forgives tokens revoked by rotation. Set to 0 for strict reuse detection.
JWT_REFRESH_GRACE=10

# Refresh-token cookie. `secure` defaults to true outside APP_ENV=local.
JWT_REFRESH_COOKIE=refresh_token
JWT_REFRESH_COOKIE_PATH=/api/v1/auth
JWT_REFRESH_COOKIE_SAME_SITE=strict
# JWT_REFRESH_COOKIE_DOMAIN=
# JWT_REFRESH_COOKIE_SECURE=true

# Login throttling / account lockout
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_DECAY=1

# Seeded platform administrator (database/seeders/AdminUserSeeder.php).
# This account has no tenant: it provisions and suspends workshops, and owns
# no books of its own.
# ADMIN_PASSWORD is mandatory when seeding in production; locally a random
# one is generated and printed once.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

#--------------------------------------------------------------------------
# Multi-tenancy (config/tenancy.php, docs/tenancy-module.md)
#--------------------------------------------------------------------------
# When true, POST /api/v1/auth/register provisions a new workshop and makes
# the registrant its owner. Set false for sales-led onboarding, where only a
# platform super-admin creates workshops via POST /api/v1/tenants.
TENANCY_ALLOW_PUBLIC_SIGNUP=true

# Role attached to a workshop's first user. Must match a slug seeded by
# RoleSeeder.
TENANCY_OWNER_ROLE=OWNER

# Two-digit GST state code used when a workshop supplies neither a state code
# nor a GSTIN. Leave empty to require one explicitly. 27 = Maharashtra.
TENANCY_DEFAULT_STATE_CODE=

# Workshop settings applied at provisioning. Editable afterwards by the owner
# through PATCH /api/v1/workspace. India's financial year runs April-March.
TENANCY_DEFAULT_FY_START_MONTH=4
TENANCY_DEFAULT_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Any S3-compatible endpoint works — AWS, Cloudflare R2, Backblaze B2, MinIO.
# Set this and AWS_USE_PATH_STYLE_ENDPOINT=true for anything that is not AWS.
# AWS_ENDPOINT=

#--------------------------------------------------------------------------
# Async jobs & object storage — M14 (config/attachments.php, docs/async-module.md)
#--------------------------------------------------------------------------
# QUEUE_CONNECTION is set above. `database` needs no extra infrastructure and
# is right up to a few thousand jobs a day; move to `redis` beyond that.
#
# A worker must be running or nothing queued ever happens, and the failure is
# silent — see docs/async-module.md for the supervisor and systemd units.
# Locally, `composer dev` starts one alongside the server.

# Where uploaded files live. `local` writes to storage/app/private/documents
# and is right for development; `s3` is any S3-compatible bucket. The bucket
# must be PRIVATE — an invoice carries a customer's name, address and GSTIN,
# and reads go through a signed expiring URL or through the application.
ATTACHMENTS_DRIVER=local
# ATTACHMENTS_BUCKET=          # defaults to AWS_BUCKET

# How long a signed read URL stays valid, in minutes. Short: the URL is a
# bearer credential for one object, and a link pasted into a chat message
# should stop working long before anybody thinks to worry about it.
ATTACHMENTS_URL_TTL=10

# Upload ceilings, in bytes. Per kind, because the honest number differs: a
# phone photograph of an invoice is a couple of megabytes and a minute of
# speech is a fraction of that. Note that PHP's own upload_max_filesize and
# post_max_size still apply and are usually the lower limit — raise them too.
# ATTACHMENTS_MAX_IMAGE_BYTES=8388608
# ATTACHMENTS_MAX_AUDIO_BYTES=4194304
# ATTACHMENTS_MAX_DOCUMENT_BYTES=10485760

# How long finished background-job records are kept, in days. Failures far
# longer than successes: a successful upload from three weeks ago is answered
# by the file itself, while a failure is the only record it was ever tried.
# Neither is an audit-log retention — audit_logs is never pruned.
# JOBS_KEEP_SUCCEEDED_DAYS=7
# JOBS_KEEP_FAILED_DAYS=90

VITE_APP_NAME="${APP_NAME}"
